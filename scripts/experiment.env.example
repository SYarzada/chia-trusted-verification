# Copy this file to experiment.env on each GCP VM and fill in the values that
# apply to your project. experiment.env is intentionally ignored by git.
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
VERTEX_LOCATION=global

# Required only for AlphaEvolve runs. If AlphaEvolve uses the same GCP project,
# ALPHAEVOLVE_PROJECT_ID can match GOOGLE_CLOUD_PROJECT.
ALPHAEVOLVE_PROJECT_ID=YOUR_GCP_PROJECT_ID
ALPHAEVOLVE_ENGINE_ID=YOUR_GEMINI_ENTERPRISE_ENGINE_ID
ALPHAEVOLVE_LOCATION=global
ALPHAEVOLVE_COLLECTION=default_collection
ALPHAEVOLVE_ASSISTANT=default_assistant
